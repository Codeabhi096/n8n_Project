# Environment configuration template
# Copy this file to .env and fill in your own values (never commit real secrets)
N8N_WEBHOOK_URL="https://your-n8n-instance.app.n8n.cloud/webhook/your-webhook-id"

# Passcode required to unlock Live Owner Mode in the Streamlit UI
# Keep this secret so public visitors remain in safe Demo Mode
OWNER_ACCESS_CODE="replace-with-a-strong-passcode"
